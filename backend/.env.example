# Environment variables for Ziva Finance Backend (Google Sheets Live + Owner Privacy)

# ==========================================
# OWNER PRIVACY & AUTHENTICATION (FAIL-CLOSED)
# ==========================================
# Only this verified email address is permitted to access the application or live APIs.
OWNER_EMAIL=your-owner-email@gmail.com

# Google OAuth 2.0 Client credentials (OpenID Connect)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Authorized JavaScript Origins: https://your-domain.com, https://ziva-finances-1.onrender.com, http://localhost:5173
# Authorized Redirect URIs: https://your-domain.com/auth/callback, http://localhost:5173/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Durable Session Secret (minimum 32 cryptographically random characters)
SESSION_SECRET=generate-a-random-32-byte-hex-or-base64-secret-key-here

# ==========================================
# WEBAUTHN PASSKEYS (FACE ID / TOUCH ID)
# ==========================================
# Relying Party ID: domain hostname without protocol or port (e.g., ziva-finances-1.onrender.com or localhost)
WEBAUTHN_RP_ID=ziva-finances-1.onrender.com
# Expected HTTPS origin where passkey authentication is performed
WEBAUTHN_ORIGIN=https://ziva-finances-1.onrender.com

# ==========================================
# PRIVATE GOOGLE DRIVE RECEIPT STORAGE
# ==========================================
# Google Drive Folder ID designated for private receipt PDFs/images.
# Find this in your Google Drive URL: https://drive.google.com/drive/folders/<FOLDER_ID>
# Ensure the service account email or OAuth user has 'Editor' or 'drive.file' access to this folder.
GOOGLE_DRIVE_RECEIPTS_FOLDER_ID=your-private-receipts-folder-id

# ==========================================
# GOOGLE SHEETS LIVE PERSISTENCE (100% BILLING-FREE)
# ==========================================
GOOGLE_SHEETS_SPREADSHEET_ID=1OjPfL4plcH33vm9KpZv2_Y435Xl10uaA1UC-Nl8kUrE
GOOGLE_SHEETS_TRANSACTIONS_TAB=fct_transactions
GOOGLE_SHEETS_DEBTS_TAB=debt_credit_ledger
GOOGLE_SHEETS_ACCOUNTS_TAB=dim_accounts
GOOGLE_SHEETS_BUDGETS_TAB=dim_budgets

# Google Service Account Credentials (either path to JSON file or raw JSON string for Render)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# Server Port
PORT=5001
NODE_ENV=production
